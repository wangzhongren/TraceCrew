# =============================================================
# TraceCrew LLM Configuration — Per-Agent Settings
# =============================================================
# Each agent (PM, Planner, Reviewer, Mapper, Executor) can have
# its own API Key, Base URL, and Model. If a per-agent setting
# is left empty, it falls back to the legacy global keys below.
# =============================================================

# ── Legacy global keys (fallback for all agents) ──
TRACECREW_LLM_API_KEY=
TRACECREW_LLM_BASE_URL=
TRACECREW_LLM_MODEL=

# ── PM (Requirements Analysis) ──
TRACECREW_LLM_PM_API_KEY=
TRACECREW_LLM_PM_BASE_URL=
TRACECREW_LLM_PM_MODEL=

# ── Architect (IoC Framework Design) ──
TRACECREW_LLM_ARCHITECT_API_KEY=
TRACECREW_LLM_ARCHITECT_BASE_URL=
TRACECREW_LLM_ARCHITECT_MODEL=

# ── Planner (Architecture Planning) ──
TRACECREW_LLM_PLANNER_API_KEY=
TRACECREW_LLM_PLANNER_BASE_URL=
TRACECREW_LLM_PLANNER_MODEL=

# ── Reviewer (Code Review) ──
TRACECREW_LLM_REVIEWER_API_KEY=
TRACECREW_LLM_REVIEWER_BASE_URL=
TRACECREW_LLM_REVIEWER_MODEL=

# ── Mapper (Code Mapping) ──
TRACECREW_LLM_MAPPER_API_KEY=
TRACECREW_LLM_MAPPER_BASE_URL=
TRACECREW_LLM_MAPPER_MODEL=

# ── Executor (Code Execution) ──
TRACECREW_LLM_EXECUTOR_API_KEY=
TRACECREW_LLM_EXECUTOR_BASE_URL=
TRACECREW_LLM_EXECUTOR_MODEL=
